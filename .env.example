# Port local exposé (ton reverse proxy HTTPS pointe dessus)
WEB_PORT=8080

# Contact obligatoire pour le Web Push (une adresse mail à toi)
VAPID_CONTACT=mailto:admin@example.com

# Whisper sur un GPU 4 Go : "small" en int8 = bon compromis.
# "medium" tient aussi en int8 mais ~2-3x plus lent. Sans GPU : WHISPER_DEVICE=cpu et WHISPER_MODEL=base
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8

# Voix Piper (chemin dans rhasspy/piper-voices, sans extension)
PIPER_VOICE=fr/fr_FR/tom/medium/fr_FR-tom-medium
# Vitesse de parole : 1.0 = normal, 1.2 = plus lent et plus inquiétant
PIPER_LENGTH_SCALE=1.2
